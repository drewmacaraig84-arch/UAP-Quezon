# Apache Configuration for UAP Quezon Chapter (React SPA Website + PHP Admin Portal)

# Ensure index.html (React Website) is the primary default index
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route /api/* to website/api/*
    RewriteRule ^api/(.*)$ website/api/$1 [QSA,L]

    # Clean URLs for auth routes (/auth/login -> /auth/login.php, /login -> /auth/login.php)
    RewriteRule ^auth/login/?$ auth/login.php [QSA,L]
    RewriteRule ^auth/register/?$ auth/register.php [QSA,L]
    RewriteRule ^login/?$ auth/login.php [QSA,L]
    RewriteRule ^register/?$ auth/register.php [QSA,L]

    # Pass through PHP backend routes and static directories
    RewriteCond %{REQUEST_URI} ^/(admin|member|auth|includes|uploads|public|database)/ [NC]
    RewriteRule ^ - [L]

    # Serve existing files and directories directly (assets/*.js, assets/*.css, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Single Page Application (SPA) fallback for React routes (/, /about, /directory, /news, /sponsors, /contact, etc.)
    RewriteRule ^.*$ index.html [L]
</IfModule>

# Security & MIME settings
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# PHP Upload File Size & Resource Limits
<IfModule mod_php8.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
