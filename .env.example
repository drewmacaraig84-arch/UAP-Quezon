# ==============================================================================
# UAP QUEZON CHAPTER - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT (Laragon / XAMPP)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uap_quezon
DB_USER=root
DB_PASS=
APP_BASE_URL=http://localhost/UAP-Quezon

# ------------------------------------------------------------------------------
# 2. INFINITYFREE HOSTING CONFIGURATION
# ------------------------------------------------------------------------------
# In InfinityFree vPanel -> "MySQL Databases", copy your database details:
# DB_HOST=sql123.infinityfree.com   <-- Assigned MySQL Host Name (NOT localhost)
# DB_PORT=3306
# DB_NAME=if0_38000000_uap_quezon   <-- Full Database Name with if0_ prefix
# DB_USER=if0_38000000              <-- Your vPanel Username
# DB_PASS=your_vpanel_password      <-- Your vPanel Account Password
# APP_BASE_URL=https://yourdomain.infinityfreeapp.com
#
# NOTE: If .env is hidden or blocked on InfinityFree, you can configure
# your credentials directly inside includes/db_config.php!

# ------------------------------------------------------------------------------
# 3. PERFORMANCE & CACHE SETTINGS
# ------------------------------------------------------------------------------
# Keep false on shared hosting like InfinityFree (prevents connection timeout)
ENABLE_REDIS=false
CACHE_TTL=300
